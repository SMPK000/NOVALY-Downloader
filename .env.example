# REQUIRED
BOT_TOKEN=123456789:REPLACE_ME
OWNER_ID=123456789
ADMIN_IDS=123456789

# Optional support account shown in the bot
SUPPORT_CONTACT=

# Persistence (use an external/attached persistent location later)
DATA_DIR=/data
PERSISTENCE_FILE=/data/bot_persistence.pickle

# Download temp directory
DOWNLOAD_DIR=/tmp/novaly_downloads

# Standard user limits
STANDARD_USER_DAILY_DOWNLOADS=5
STANDARD_USER_FILE_SIZE_LIMIT_MB=25
PREMIUM_ADMIN_DIRECT_SEND_LIMIT_MB=49.5


# Optional YouTube PO token. Leave empty unless you have a valid current token.
YTDLP_PO_TOKEN=

# Optional: comma-separated YouTube clients. Leave empty to use yt-dlp's current defaults.
YTDLP_PLAYER_CLIENTS=

# Deno is installed by the supplied Dockerfile.
YTDLP_JS_RUNTIME=deno
# No personal cookies are required. The Docker image starts a local bgutil PO-token provider.

# Leave empty because yt-dlp[default] includes yt-dlp-ejs.
YTDLP_REMOTE_COMPONENTS=

# Optional browser-like UA override
YTDLP_USER_AGENT=
